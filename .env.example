# LedgerAI Configuration
PROJECT_NAME="LedgerAI – Continuous Bank Reconciliation & Bookkeeping Agent"
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=ledgerai-production-super-secure-key-32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default for zero-setup local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./ledgerai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ledgerai

# Base Currency
DEFAULT_BASE_CURRENCY=USD

# Optional LLM Key (Gemini API for optional natural language enhancement)
GEMINI_API_KEY=

